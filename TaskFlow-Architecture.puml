@startuml
 title TaskFlow API — Component Diagram
 left to right direction
 skinparam componentStyle rectangle
 skinparam packageStyle rectangle

 actor "API Client" as Client
 database "MySQL" as MySQL

 package "Web layer" {
   [AuthController] as AuthController
   [UserController] as UserController
   [TaskController] as TaskController
   [CommentController] as CommentController
   [ApiExceptionHandler] as ErrorHandler
 }

 package "Application layer" {
   [AuthService] as AuthService
   [UserService] as UserService
   [TaskService] as TaskService
   [CommentService] as CommentService
 }

 package "Persistence layer (Spring Data JPA)" {
   [UserRepository] as UserRepository
   [TaskRepository] as TaskRepository
   [TaskCommentRepository] as CommentRepository
 }

 package "Domain model" {
   [AppUser] as AppUser
   [Task] as Task
   [TaskComment] as TaskComment
 }

 component "Spring Security\nJWT resource server" as Security
 component "Flyway migrations" as Flyway

 Client --> Security : bearer token
 Client --> AuthController : register / login
 Client --> UserController
 Client --> TaskController
 Client --> CommentController
 AuthController --> AuthService
 UserController --> UserService
 TaskController --> TaskService
 CommentController --> CommentService
 AuthService --> UserRepository
 UserService --> UserRepository
 TaskService --> UserRepository
 TaskService --> TaskRepository
 CommentService --> TaskRepository
 CommentService --> CommentRepository
 UserRepository ..> AppUser : reads / writes
 TaskRepository ..> Task : reads / writes
 CommentRepository ..> TaskComment : reads / writes
 UserRepository --> MySQL : JPA
 TaskRepository --> MySQL : JPA
 CommentRepository --> MySQL : JPA
 Flyway --> MySQL : schema migrations
 Security ..> UserController : protects endpoints
 Security ..> TaskController
 Security ..> CommentController
 AuthController ..> ErrorHandler : exceptions handled
 UserController ..> ErrorHandler
 TaskController ..> ErrorHandler
 CommentController ..> ErrorHandler
@enduml
